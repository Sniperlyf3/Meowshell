diff --git a/cmd/tailcat/tailcat.go b/cmd/tailcat/tailcat.go
--- a/cmd/tailcat/tailcat.go
+++ b/cmd/tailcat/tailcat.go
@@ -95 +95 @@ func newRootCommand() *ff.Command {
-	flagKey = rootFS.StringLong("key", "", "'new' for an ephemeral key. If empty, the default saved key is used if it exists ('default' in server mode, 'client-default' in client modes; see genkey), else an ephemeral key. Otherwise the path to a *.private.json or a name like 'foo' to read it from $CONFIG/tailcat/keys/foo.private.json")
+	flagKey = rootFS.StringLong("key", "", "'new' for an ephemeral key, '-' to read a *.private.json from stdin, or a saved key path/name. If empty, the default saved key is used if it exists ('default' in server mode, 'client-default' in client modes; see genkey), else an ephemeral key")
@@ -793,2 +793 @@ func clientKey() key.NodePrivate {
-	path := keyPath(*flagKey)
-	j, err := os.ReadFile(path)
+	j, path, err := readKeyJSON(*flagKey)
@@ -1323,2 +1322 @@ func serve(args []string) error {
-		path := keyPath(*flagKey)
-		j, err := os.ReadFile(path)
+		j, path, err := readKeyJSON(*flagKey)
@@ -1728,3 +1726,20 @@ func keyIsPath(name string) bool {
 	return strings.ContainsAny(name, `/\`)
 }
 
+func readKeyJSON(name string) ([]byte, string, error) {
+	if name == "-" {
+		const maxKeyJSON = 64 << 10
+		j, err := io.ReadAll(io.LimitReader(os.Stdin, maxKeyJSON+1))
+		if err != nil {
+			return nil, "stdin", err
+		}
+		if len(j) > maxKeyJSON {
+			return nil, "stdin", fmt.Errorf("private key JSON from stdin exceeds %d bytes", maxKeyJSON)
+		}
+		return j, "stdin", nil
+	}
+	path := keyPath(name)
+	j, err := os.ReadFile(path)
+	return j, path, err
+}
+
