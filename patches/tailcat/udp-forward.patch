+const udpForwardIdleTimeout = 2 * time.Minute
+
+type udpForwardFlow struct {
+	remote tailcat.ConnPacketConn
+	client *net.UDPAddr
+}
+
+func runUDPForward(ctx context.Context, logf logger.Logf, bind string, args []string) error {
+	if len(args) < 2 {
+		return usagef("forward --udp takes a <tc-addr> and at least one port mapping")
+	}
+
+	cl := newClient(logf, tailcatAddrArg(args[0]), clientKey())
+	ctx, stop := signal.NotifyContext(ctx, os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	listeners := make([]*net.UDPConn, 0, len(args)-1)
+	var wg sync.WaitGroup
+	defer func() {
+		stop()
+		for _, conn := range listeners {
+			_ = conn.Close()
+		}
+		wg.Wait()
+		_ = cl.Close()
+	}()
+
+	for _, spec := range args[1:] {
+		mapping, err := parseForwardSpec(bind, spec)
+		if err != nil {
+			return usagef("mapping %q is invalid: %v", spec, err)
+		}
+		addr, err := net.ResolveUDPAddr("udp", mapping.listenAddr)
+		if err != nil {
+			return fmt.Errorf("resolve UDP listen address %s: %w", mapping.listenAddr, err)
+		}
+		conn, err := net.ListenUDP("udp", addr)
+		if err != nil {
+			return fmt.Errorf("listen UDP on %s: %w", mapping.listenAddr, err)
+		}
+		listeners = append(listeners, conn)
+		fmt.Fprintf(os.Stderr, "# forwarding udp %s -> remote %s\n", conn.LocalAddr(), mapping.remoteTarget())
+		wg.Add(1)
+		go udpForwardListener(ctx, logf, cl, conn, mapping, &wg)
+	}
+
+	<-ctx.Done()
+	return nil
+}
+
+func udpForwardListener(ctx context.Context, logf logger.Logf, cl *tailcat.Client, local *net.UDPConn, mapping forwardSpec, wg *sync.WaitGroup) {
+	defer wg.Done()
+	var mu sync.Mutex
+	flows := map[string]*udpForwardFlow{}
+	defer func() {
+		mu.Lock()
+		defer mu.Unlock()
+		for _, flow := range flows {
+			_ = flow.remote.Close()
+		}
+	}()
+
+	buf := make([]byte, 65535)
+	for {
+		n, clientAddr, err := local.ReadFromUDP(buf)
+		if err != nil {
+			return
+		}
+		key := clientAddr.String()
+		mu.Lock()
+		flow := flows[key]
+		mu.Unlock()
+		if flow == nil {
+			remote, err := dialUDPForward(ctx, cl, mapping)
+			if err != nil {
+				if ctx.Err() == nil {
+					logf("dial UDP remote target %s: %v", mapping.remoteTarget(), err)
+				}
+				continue
+			}
+			flow = &udpForwardFlow{remote: remote, client: clientAddr}
+			mu.Lock()
+			if existing := flows[key]; existing != nil {
+				mu.Unlock()
+				_ = remote.Close()
+				flow = existing
+			} else {
+				flows[key] = flow
+				mu.Unlock()
+				wg.Add(1)
+				go func(key string, f *udpForwardFlow) {
+					defer wg.Done()
+					udpForwardResponses(local, f)
+					mu.Lock()
+					if flows[key] == f {
+						delete(flows, key)
+					}
+					mu.Unlock()
+				}(key, flow)
+			}
+		}
+		_ = flow.remote.SetDeadline(time.Now().Add(udpForwardIdleTimeout))
+		if _, err := flow.remote.Write(buf[:n]); err != nil && ctx.Err() == nil {
+			logf("forward UDP to remote target %s: %v", mapping.remoteTarget(), err)
+			_ = flow.remote.Close()
+		}
+	}
+}
+
+func dialUDPForward(ctx context.Context, cl *tailcat.Client, mapping forwardSpec) (tailcat.ConnPacketConn, error) {
+	if mapping.target.IsValid() {
+		return cl.DialUDP(ctx, mapping.target)
+	}
+	return cl.DialUDPPort(ctx, mapping.port)
+}
+
+func udpForwardResponses(local *net.UDPConn, flow *udpForwardFlow) {
+	defer flow.remote.Close()
+	buf := make([]byte, 65535)
+	for {
+		n, err := flow.remote.Read(buf)
+		if err != nil {
+			return
+		}
+		_ = flow.remote.SetDeadline(time.Now().Add(udpForwardIdleTimeout))
+		if _, err := local.WriteToUDP(buf[:n], flow.client); err != nil {
+			return
+		}
+	}
+}
 
 func parseForwardSpec(bind, spec string) (forwardSpec, error) {
 	local, target, hasColon := strings.Cut(spec, ":")
