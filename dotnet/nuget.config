<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Relative to this file, so it resolves to <repo root>/nupkg
         regardless of the working directory a build is run from. This
         folder is gitignored and may not exist on a fresh clone: if
         restore fails with NU1301, run "mkdir nupkg" at the repo root. -->
    <add key="local" value="../nupkg" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
